# Fryseboksen – miljøvariabler
#
# Kopier denne filen til .env.local og fyll inn verdiene fra Supabase-prosjektet.
# .env.local er ignorert av Git. Legg aldri ekte nøkler i .env.example.
#
# Supabase: Project Settings -> API

# Prosjektets API-adresse. Trygg i nettleseren.
NEXT_PUBLIC_SUPABASE_URL="https://ditt-prosjekt.supabase.co"

# Publiserbar nøkkel (anon / publishable). Trygg i nettleseren; RLS er sikkerhetsgrensen.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Adressen nettstedet kjører på. Brukes til retur-URL for innloggingslenken.
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Hemmelig servernøkkel. Kun kontosletting. Skal aldri nå nettleseren.
SUPABASE_SERVICE_ROLE_KEY=""

# Direkte databasetilkobling. Kun migrasjoner og lokale databasetester.
# Supabase: Project Settings -> Database -> Connection string -> URI
# Databasetestene hoppes over når denne mangler.
SUPABASE_DB_URL=""
